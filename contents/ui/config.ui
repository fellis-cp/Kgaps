                            </item>
                            <item>
                                <widget class="QGroupBox" name="groupDock">
                                    <property name="title">
                                        <string>Dock / Panel Floating Compensation</string>
                                    </property>
                                    <layout class="QVBoxLayout" name="layoutDock">
                                        <item>
                                            <widget class="QCheckBox" name="kcfg_compensateDock">
                                                <property name="text">
                                                    <string>Add extra margin adjacent to floating panels/docks</string>
                                                </property>
                                                <property name="toolTip">
                                                    <string>Prevents KDE floating panels from de-floating and snapping flat when a window is maximized.</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item>
                                            <layout class="QHBoxLayout" name="layoutDockMargin">
                                                <item>
                                                    <widget class="QLabel" name="labelDockMargin">
                                                        <property name="text">
                                                            <string>Dock extra margin:</string>
                                                        </property>
                                                    </widget>
                                                </item>
                                                <item>
                                                    <widget class="QSpinBox" name="kcfg_dockMargin">
                                                        <property name="minimum">
                                                            <number>0</number>
                                                        </property>
                                                        <property name="maximum">
                                                            <number>50</number>
                                                        </property>
                                                        <property name="value">
                                                            <number>12</number>
                                                        </property>
                                                        <property name="suffix">
                                                            <string> px</string>
                                                        </property>
                                                    </widget>
                                                </item>
                                                <item>
