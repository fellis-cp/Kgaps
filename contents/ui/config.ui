                                                    <number>200</number>
                                                </property>
                                                <property name="value">
                                                    <number>15</number>
                                                </property>
                                                <property name="suffix">
                                                    <string> px</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <!-- Left -->
                                        <item row="2" column="0">
                                            <widget class="QLabel" name="labelLeft">
                                                <property name="text">
                                                    <string>Left gap:</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="2" column="1">
                                            <widget class="QSpinBox" name="kcfg_gapLeft">
                                                <property name="minimum">
                                                    <number>0</number>
                                                </property>
