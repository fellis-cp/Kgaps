                                        <item row="3" column="0">
                                            <widget class="QLabel" name="labelRight">
                                                <property name="text">
                                                    <string>Right gap:</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="3" column="1">
                                            <widget class="QSpinBox" name="kcfg_gapRight">
                                                <property name="minimum">
                                                    <number>0</number>
                                                </property>
                                                <property name="maximum">
                                                    <number>200</number>
                                                </property>
                                                <property name="value">
                                                    <number>15</number>
