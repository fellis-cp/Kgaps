                            <item>
                                <spacer name="spacerPadding">
                                    <property name="orientation">
                                        <enum>Qt::Vertical</enum>
                                    </property>
                                </spacer>
                            </item>
                        </layout>
                    </widget>

                    <!-- Tab 2: Window Behavior -->
                    <widget class="QWidget" name="tabBehavior">
                        <attribute name="title">
                            <string>Behavior</string>
                        </attribute>
                        <layout class="QVBoxLayout" name="behaviorLayout">
                            <item>
                                <widget class="QCheckBox" name="kcfg_autoMaximizeNewWindows">
                                    <property name="text">
                                        <string>Automatically maximize newly opened windows (with gaps)</string>
                                    </property>
                                    <property name="toolTip">
                                        <string>When enabled, every eligible application window will automatically maximize with gaps upon launch.</string>
                                    </property>
                                </widget>
                            </item>
                            <item>
                                <widget class="QCheckBox" name="kcfg_applyToFullscreen">
                                    <property name="text">
                                        <string>Apply gaps to fullscreen windows</string>
                                    </property>
                                    <property name="toolTip">
                                        <string>By default, true fullscreen windows (e.g. video players, games) remain full screen. Enable this to force padding onto fullscreen apps.</string>
                                    </property>
                                </widget>
                            </item>
                            <item>
                                <spacer name="spacerBehavior">
                                    <property name="orientation">
                                        <enum>Qt::Vertical</enum>
                                    </property>
                                </spacer>
                            </item>
                        </layout>
                    </widget>

                    <!-- Tab 3: Exclusions -->
                    <widget class="QWidget" name="tabIgnored">
                        <attribute name="title">
                            <string>Exclusions</string>
                        </attribute>
                        <layout class="QVBoxLayout" name="ignoredLayout">
                            <item>
                                <widget class="QLabel" name="labelIgnoredInfo">
                                    <property name="text">
                                        <string>System overlays (plasmashell, krunner, spectacle, polkit, etc.) are always excluded.

Add extra apps below by their window class name (comma-separated, e.g. "discord, steam, gimp"):</string>
                                    </property>
                                    <property name="wordWrap">
                                        <bool>true</bool>
                                    </property>
                                </widget>
                            </item>
                            <item>
                                <widget class="QLineEdit" name="kcfg_ignoredApps">
                                    <property name="placeholderText">
                                        <string>e.g. steam, vlc, discord</string>
                                    </property>
                                </widget>
                            </item>
                            <item>
                                <spacer name="spacerIgnored">
                                    <property name="orientation">
                                        <enum>Qt::Vertical</enum>
                                    </property>
                                </spacer>
                            </item>
                        </layout>
                    </widget>
                </widget>
            </item>
        </layout>
    </widget>
